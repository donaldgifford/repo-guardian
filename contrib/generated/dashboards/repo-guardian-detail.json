        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(max by (org, control) (repo_guardian_controls_coverage{org=\"$org\"}))",
          "instant": true,
          "range": false
        }
      ],
      "title": "Control assignments",
      "description": "Assignments in this organisation. Reads 'no data' if the org has stopped being measured entirely, which is a different condition from zero assignments.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
