{
  "uid": "repo-guardian-logs",
  "title": "repo-guardian — logs",
  "description": "Evidence tier: which repository, and why. Reads Loki, not Prometheus. If every panel is empty, check the stream selector before believing the silence.",
  "tags": [
    "repo-guardian",
    "generated"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({app=\"repo-guardian\"} | json [$__interval]))",
          "legendFormat": "{{ level }}"
        }
      ],
      "title": "Log lines by level",
      "description": "The shape of the log, not its contents. A step change in WARN volume with a flat ERROR rate is usually one repository going bad, not the service. Stream selector: `{app=\"repo-guardian\"}` — if this panel is empty, nothing else on the dashboard can work.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "topk(10,\n  sum by (msg) (count_over_time({app=\"repo-guardian\"} | json | level=~\"ERROR|WARN\" [15m]))\n)",
          "legendFormat": "{{ msg }}"
        }
      ],
      "title": "Top error and warning messages",
      "description": "Grouped by message, so a single repeating fault is one line rather than a wall. Messages are static strings; the variable parts are structured fields, which is what makes this grouping bounded.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{app=\"repo-guardian\"} | json | level=\"ERROR\"",
          "maxLines": 200
        }
      ],
      "title": "Recent errors",
      "description": "Newest first. The first place to look when any alert on E1 or E3 fires.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": false,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": false,
        "sortOrder": "Descending",
        "dedupStrategy": ""
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Repository faults",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (repository_id, reason) (\n  count_over_time({app=\"repo-guardian\"} |= \"parking repository until discovery sees it again\" | json [1h])\n)",
          "legendFormat": "{{ repository_id }} ({{ reason }})"
        }
      ],
      "title": "Parked repositories",
      "description": "Repositories the Evaluation App can no longer read — archived, forked, transferred or un-installed. Parking is why assignments can fall without anything being wrong, and this is the only per-repository record of it.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
