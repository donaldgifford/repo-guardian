      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (increase(repo_guardian_repos_parked_total[24h]))",
          "instant": false,
          "legendFormat": "{{ reason }}",
          "range": true
        }
      ],
      "title": "Repositories parked in the last 24h",
      "description": "Why repositories left the measurable fleet. This is the denominator context for every compliance number above: archived and fork parks are routine, a rising access_denied share is the one to act on.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "min by (org) (\n  repo_guardian_rate_limit_remaining\n  * on (installation_id) group_left(org) repo_guardian_installation_info\n)",
          "instant": false,
          "legendFormat": "{{ org }}",
          "range": true
        }
      ],
      "title": "GitHub API budget by org",
      "description": "Remaining API budget, joined from the installation-keyed gauge onto orgs via installation_info. group_left is what makes an installation_id-keyed series answerable per org at all; without the join this panel could only be read by someone who knows which installation belongs to whom.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
