        {
          "expr": "(\n  sum (max by (org, control) (repo_guardian_controls_status{bucket=\"compliant\"}))\n  /\n  (sum (max by (org, control, bucket) (repo_guardian_controls_status{bucket=~\"compliant|non_compliant\"})) \u003e 0)\n)\nand on() (sum (max by (org, control) (repo_guardian_controls_coverage)) \u003e 0)",
          "instant": true,
          "range": false
