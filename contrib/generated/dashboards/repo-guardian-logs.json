          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (owner, repo) (\n  count_over_time({app=\"repo-guardian\"} |= \"job exceeded attempt cap\" | json [1h])\n)",
          "legendFormat": "{{ owner }}/{{ repo }}"
        }
      ],
      "title": "Jobs dropped at the attempt cap",
      "description": "A job that hit MAX_JOB_ATTEMPTS and was acked away rather than retried forever. The repository is not lost — the stale sweep is its recovery path — but it will not converge until the sweep picks it up.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
