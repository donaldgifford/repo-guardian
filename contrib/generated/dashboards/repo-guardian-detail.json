{
  "uid": "repo-guardian-detail",
  "title": "repo-guardian — detail",
  "description": "Fleet aggregates and a section per organisation.",
  "tags": [
    "repo-guardian",
    "generated"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "1m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "(\n  sum by (org) (max by (org, control) (repo_guardian_controls_status{bucket=\"compliant\"}))\n  /\n  (sum by (org) (max by (org, control, bucket) (repo_guardian_controls_status{bucket=~\"compliant|non_compliant\"})) \u003e 0)\n)\nand on (org) (sum by (org) (max by (org, control) (repo_guardian_controls_coverage)) \u003e 0)",
          "instant": false,
          "legendFormat": "{{ org }}",
          "range": true
        }
      ],
      "title": "Compliance by org",
      "description": "Each organisation's compliant share across its control assignments. An org drops out rather than reading 100% when it measures nothing.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "no data",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (org) (max by (org, control) (repo_guardian_controls_coverage))",
          "instant": false,
          "legendFormat": "{{ org }}",
          "range": true
        }
      ],
      "title": "Control assignments by org",
      "description": "Assignments per organisation. A line that drops to zero is an org that stopped being measured — which is the signal a declared row exists to preserve.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
