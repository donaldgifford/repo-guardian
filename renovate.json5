{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>donaldgifford/renovate-config",
    "github>donaldgifford/renovate-config:go",
    "github>donaldgifford/renovate-config:docker",
    "github>donaldgifford/renovate-config:mise",
    "github>donaldgifford/renovate-config:helm",
    "github>donaldgifford/renovate-config:ci",
    "github>donaldgifford/renovate-config:node"
  ],
  "packageRules": [
    {
      // The SLSA generator verifies its own ref at runtime, so it must be
      // referenced by a semver tag; a digest pin fails the provenance job
      // (closed PR #106). See CLAUDE.md § Release.
      "matchPackageNames": ["slsa-framework/slsa-github-generator"],
      "pinDigests": false
    },
    {
      // The shared design system moves every page at once: its own pull
      // request, never grouped with other npm updates, never automerged
      // (IMPL-0037, DESIGN-0039).
      "matchPackageNames": ["@donaldgifford/design-system"],
      "groupName": null,
      "automerge": false
    }
  ]
}
