    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "(\n  sum by (control) (max by (org, control) (repo_guardian_controls_status{bucket=\"compliant\", org=\"$org\"}))\n  /\n  (sum by (control) (max by (org, control, bucket) (repo_guardian_controls_status{bucket=~\"compliant|non_compliant\", org=\"$org\"})) \u003e 0)\n)\nand on (control) (sum by (control) (max by (org, control) (repo_guardian_controls_coverage{org=\"$org\"})) \u003e 0)",
          "instant": false,
          "legendFormat": "{{ control }}",
          "range": true
        }
      ],
      "title": "Compliance by control",
      "description": "Share of this organisation's measured repositories passing each control. Blank for a control that measures nothing here — an unmeasured control is not a compliant one.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
