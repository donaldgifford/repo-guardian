        "overrides": []
      }
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{app=\"repo-guardian\"} |~ \"rate limit throttled; deferring job|job exceeded attempt cap\" | json",
          "maxLines": 200
        }
      ],
      "title": "Deferrals and drops",
      "description": "The rate-limit path end to end. A deferral is not a failure: the check never ran, so there is deliberately no error counted and no write-back recorded. Repeated deferrals of the same repository are how a job walks to the attempt cap.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
