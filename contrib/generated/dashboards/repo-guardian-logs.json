    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (owner, repo, reason) (\n  count_over_time({app=\"repo-guardian\"} |= \"parking repository until discovery sees it again\" | json [1h])\n)",
          "legendFormat": "{{ owner }}/{{ repo }} ({{ reason }})"
        }
      ],
      "title": "Parked repositories",
      "description": "Repositories the installation can no longer read — archived, forked, transferred or un-installed. Parking is why repos_tracked can fall without anything being wrong, and this is the only per-repository record of it.",
      "transparent": false,
