    {
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"repo-guardian\"} |= \"rate limit throttled; deferring evaluation\" [15m]))",
          "legendFormat": "deferred"
        },
        {
          "expr": "sum(count_over_time({app=\"repo-guardian\"} |= \"evaluation failed after retries\" [15m]))",
          "legendFormat": "failed"
        }
      ],
      "title": "Deferred and failed evaluations",
      "description": "A deferral is not a failure: the evaluation never ran, so there is deliberately no error counted and no result recorded. A failed evaluation exhausted its activity retries and waits for the next interval.",
      "transparent": false,
      "datasource": {
