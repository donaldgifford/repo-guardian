      "targets": [
        {
          "expr": "{app=\"repo-guardian\"} |= \"catalog-info parse failed\" | json",
          "maxLines": 200
        }
      ],
      "title": "catalog-info parse failures",
      "description": "The `err` field says what is wrong with the file. Note the sibling condition — a valid non-Component entity — logs at INFO under a different message and is not a fault; this panel deliberately does not match it.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
