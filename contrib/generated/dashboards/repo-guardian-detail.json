  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "org",
        "label": "Organisation",
        "skipUrlSync": false,
        "query": "label_values(repo_guardian_repos_tracked, org)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "multi": true,
        "allowCustomValue": true,
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "auto": false,
        "auto_min": "10s",
        "auto_count": 30
      }
    ]
