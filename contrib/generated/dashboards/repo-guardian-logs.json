      "targets": [
        {
          "expr": "sum by (owner, repo) (\n  count_over_time({app=\"repo-guardian\"} |= \"catalog-info parse failed\" | json [1h])\n)",
          "legendFormat": "{{ owner }}/{{ repo }}"
        }
      ],
      "title": "Repositories with an unparseable catalog-info",
      "description": "The named counterpart to catalog_parse_failed_total, which says how many but not which. A repository here has had its custom properties left alone rather than cleared — deliberately (INV-0011 A1), and invisibly until you look here.",
      "transparent": false,
      "datasource": {
