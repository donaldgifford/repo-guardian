    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{app=\"repo-guardian\"} |= \"assignment awaits re-resolution\" | json",
          "maxLines": 200
        }
      ],
      "title": "Assignments awaiting re-resolution",
      "description": "Stored assignments whose control revision the running policy no longer carries. They are skipped, not failed, until the policy rollout re-resolves the repository; one that stays here past POLICY_ROLLOUT_WINDOW is stuck.",
      "transparent": false,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "repeatDirection": "h",
      "options": {
        "showLabels": false,
        "showCommonLabels": false,
        "showTime": true,
        "showLogContextToggle": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": false,
        "sortOrder": "Descending",
        "dedupStrategy": ""
      }
    },
    {
      "type": "logs",
      "targets": [
        {
          "expr": "{app=\"repo-guardian\"} |= \"controls discovery: installation listing incomplete\" | json",
          "maxLines": 200
        }
      ],
      "title": "Incomplete discovery listings",
      "description": "An installation whose repository listing failed. Discovery parks nothing after an incomplete listing, so a removed repository stays assigned until a pass completes.",
